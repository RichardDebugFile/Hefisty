# Copia este archivo a .env (gitignoreado) y ajusta los valores. NUNCA subas .env al repo.

# Token Bearer del gateway. Vacío = auth desactivada (solo dev local en 127.0.0.1).
HEFISTY_API_TOKEN=

# Red del gateway (escucha solo en loopback por defecto).
HEFISTY_HOST=127.0.0.1
HEFISTY_PORT=8080

# Servicios. Ollama corre nativo en el host; Redis y Qdrant en Docker.
HEFISTY_OLLAMA_URL=http://127.0.0.1:11434
HEFISTY_REDIS_URL=redis://127.0.0.1:6379/0
HEFISTY_QDRANT_URL=http://127.0.0.1:6333

# Modelos (deben existir en Ollama; ver scripts/setup.ps1).
HEFISTY_MODEL_FRONTAL=qwen3:1.7b
HEFISTY_MODEL_CODER=qwen2.5-coder:14b
HEFISTY_MODEL_EMBED=nomic-embed-text
HEFISTY_KEEP_ALIVE=10m

# Directorios locales (gitignoreados).
HEFISTY_WORKSPACE_DIR=workspace
HEFISTY_DATA_DIR=data

# Cache L1 (segundos): conversación vs código.
HEFISTY_CACHE_TTL_CHAT=3600
HEFISTY_CACHE_TTL_CODE=600

# Límite de tamaño de entrada (caracteres).
HEFISTY_MAX_INPUT_CHARS=32000
